# MinisManager games screen: one headless 1080p output streamed by Sunshine.
# No bar, no gaps; ES-DE and every emulator fullscreen.
include /home/retro/.config/sway/custom-cfg
set $mod Mod1
include /etc/sway/config-vars.d/*
include /etc/sway/config.d/*
default_border none
default_floating_border none
gaps inner 0
gaps outer 0
focus_follows_mouse no
seat * hide_cursor 3000
bindsym Alt+F4 kill
for_window [app_id=".*"] fullscreen enable
for_window [class=".*"] fullscreen enable
# Some apps (RPCS3's window) undo the rule above after they appear: make every new window fullscreen.
exec_always sh -c 'swaymsg -r -t subscribe -m "[\"window\"]" | while read -r l; do case "$l" in *"\"change\":\"new\""*|*"\"change\": \"new\""*) sleep 0.3; swaymsg fullscreen enable >/dev/null;; esac; done'
