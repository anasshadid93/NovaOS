<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/canvas"
        app:navigationContentDescription="Back"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/settings_title"
        app:titleTextColor="@color/heading" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        style="@style/TextMuted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pref_server"
                        android:textAllCaps="true"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/server"
                        style="@style/TextBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textIsSelectable="false" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/changeServer"
                        style="@style/MM.Button.Tonal"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="10dp"
                        android:text="@string/pref_change_server"
                        app:cornerRadius="14dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/reload"
                        style="@style/MM.Button.Text"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="@string/pref_reload" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="14dp"
                        android:background="@color/primary_soft" />

                    <LinearLayout
                        android:id="@+id/notificationsGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/notifications"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="56dp"
                            android:text="@string/pref_notifications"
                            android:textAppearance="?attr/textAppearanceTitleMedium" />

                        <TextView
                            style="@style/TextMuted"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/pref_notifications_summary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/test"
                            style="@style/MM.Button.Tonal"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:layout_marginTop="10dp"
                            android:text="@string/pref_test_notification"
                            app:cornerRadius="14dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/battery"
                            style="@style/MM.Button.Text"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:text="@string/pref_battery" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="14dp"
                            android:background="@color/primary_soft" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/biometricGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/biometric"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="56dp"
                            android:text="@string/pref_biometric"
                            android:textAppearance="?attr/textAppearanceTitleMedium" />

                        <TextView
                            style="@style/TextMuted"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/pref_biometric_summary" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="14dp"
                            android:background="@color/primary_soft" />
                    </LinearLayout>

                    <TextView
                        style="@style/TextMuted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pref_about"
                        android:textAllCaps="true"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/version"
                        style="@style/TextBody"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>
    </ScrollView>
</LinearLayout>
